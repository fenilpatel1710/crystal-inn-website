# Existing dedicated-integration adapter: NOT deployed in Lumen; disabled by default.
LUMEN_INTEGRATION_ENABLED=false
LUMEN_INTEGRATION_BASE_URL=https://your-approved-lumen-api.example/
LUMEN_INTEGRATION_ALLOWED_HOST=your-approved-lumen-api.example
LUMEN_INTEGRATION_API_KEY=
LUMEN_HOTEL_UNIQUE_ID=

# OPTIONAL single-hotel pilot using Lumen's current staff REST API.
# Strictly internal, protected read-only preview; disabled by default.
# DO NOT enable without Lumen authorization, least-privilege account and security remediation.
LUMEN_LEGACY_PILOT_ENABLED=false
LUMEN_LEGACY_BASE_URL=https://lumenpms.com/
LUMEN_LEGACY_STAFF_EMAIL=
LUMEN_LEGACY_STAFF_PASSWORD=
LUMEN_PILOT_PREVIEW_TOKEN=

# Firebase phone authentication (not active until all values configured in Cloudflare).
# Firebase Phone Auth requires a Blaze billing account, Phone provider enabled,
# an approved SMS region policy and crystalinnstay.com as an authorized domain.
# The API key and client identifiers are public Firebase web-app configuration.
# Never commit Firebase Admin service-account keys.
GUEST_AUTH_PROVIDER=twilio
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Retain GUEST_AUTH_PEPPER (at least 32 random characters) and DB D1 binding.
# After testing: set GUEST_AUTH_PROVIDER=firebase and disable GUEST_OTP_ENABLED.
